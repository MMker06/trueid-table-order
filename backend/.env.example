# ─────────────────────────────────────────────
# TrueID 백엔드 환경변수 예시
# 이 파일을 backend/.env 로 복사한 뒤 값을 채우세요.
# backend/.env 는 .gitignore 에 등록되어 있습니다 — 절대 커밋하지 마세요.
# ─────────────────────────────────────────────

# DB / 캐시
DATABASE_URL=postgresql://trueid:password@localhost:5432/trueid_db
REDIS_URL=redis://localhost:6379/0

# JWT (필수) — python scripts/gen_secret.py 로 생성
SECRET_KEY=change-me-run-scripts-gen_secret.py
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 파일 스토리지 (local | s3)
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# 생체정보 암호화 키 (필수, 32자) — python scripts/gen_secret.py 로 생성
BIOMETRIC_ENCRYPTION_KEY=change-me-32-bytes-key-goes-here

# 성인인증 QR(MINCERT) 서명 키 (필수, 기본값 없음)
# 설정하지 않으면 QR 생성/검증 시 RuntimeError 가 납니다.
CERT_QR_SECRET=change-me-run-scripts-gen_secret.py

# 카카오 OAuth (모바일 인증용)
# https://developers.kakao.com 에서 앱을 만들고 "카카오 로그인" + 생일/출생연도 동의항목을 켜세요.
# REDIRECT_URI 는 손님 휴대폰에서 접근 가능한 주소여야 합니다(HTTPS 터널 등).
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/api/v1/orders/kakao-callback

# CODEF 신분증 진위확인 API (선택 — 미설정 시 해당 기능만 비활성)
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
CODEF_MODE=demo

# 신분증 위변조 판별 모델 가중치 경로 (선택)
ID_VERIFY_MODEL_PATH=

# 외부 인증 연동 (미구현 — 자리만 잡아둠)
PASS_API_KEY=
PASS_API_SECRET=
SMS_API_KEY=
